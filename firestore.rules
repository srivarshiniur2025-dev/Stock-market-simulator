rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null && request.auth.token.email == 'codemogger@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isMember(sessionId) {
      return request.auth != null && sessionId is string &&
        exists(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    match /stocks/{stockId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /price_history/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Competition sessions. Participants only see data of sessions they joined.
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /participants/{uid} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid) || isMember(sessionId);
        allow create: if request.auth != null && request.auth.uid == uid &&
          request.resource.data.userId == uid &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.status != 'COMPLETED' &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('acceptingParticipants', true) != false &&
          request.resource.data.currentCash == get(/databases/$(database)/documents/sessions/$(sessionId)).data.startingBalance &&
          request.resource.data.startingBalance == get(/databases/$(database)/documents/sessions/$(sessionId)).data.startingBalance;
        allow update: if isAdmin() || (
          request.auth != null && request.auth.uid == uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.startingBalance == resource.data.startingBalance
        );
        allow delete: if isAdmin();
      }
    }

    match /holdings/{docId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.userId == request.auth.uid) ||
        isMember(resource.data.get('sessionId', null));
      allow write: if request.auth != null && (
        isAdmin() || 
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }
    match /transactions/{docId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.userId == request.auth.uid) ||
        isMember(resource.data.get('sessionId', null));
      allow write: if request.auth != null && (
        isAdmin() || 
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }
    match /simulation/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /news/{newsId} {
      allow read: if isAdmin() || isMember(resource.data.get('sessionId', null));
      allow write: if isAdmin();
    }
  }
}
